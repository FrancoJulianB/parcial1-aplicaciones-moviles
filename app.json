{
  "expo": {
    "name": "Mi lista de compras",
    "slug": "lista-compras-parcial",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.francobarrera.listacompras"
    },
    "android": {
      "package": "com.francobarrera.listacompras"
    },
    "plugins": [
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permití usar la cámara para fotografiar tus productos.",
          "photosPermission": "Permití acceder a tus fotos para elegir una imagen del producto.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permití usar tu ubicación para asociar el comercio al producto.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permití acceder a tus contactos para asociar uno al producto."
        }
      ]
    ]
  }
}
